            {
                out=out+str.substring(0,pt+2)+str.substring(pt+2,pt+3).toUpperCase();
                str=str.substring(pt+3);
            }
            else
            {
                out=out+str.substring(0,pt+1)+str.substring(pt+1,pt+2).toUpperCase();
                str=str.substring(pt+2);
            }
             pt=str.indexOf('。');
        }
        out=out+str;
        return out;
    }
