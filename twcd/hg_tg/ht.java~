            {
                trantmp=nreplace(trantmp,notran[i].code,notran[i].word);
            }
                 for (i=0;i<phcnt;i++)
                {
                        stok[ii]=replace(stok[ii],phase[i].code,phase[i].word);
                }
                //處理大寫啦！
                pt=0;
                while (pt+1<stok[ii].length() && stok[ii].charAt(pt)==' ') pt=pt+1;
